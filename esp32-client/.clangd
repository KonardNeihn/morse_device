CompileFlags:
  # Use the compilation database that the ESP-IDF/cmake build produces in .pio,
  # because it contains the project's own source files (the root-level
  # compile_commands.json generated by `pio run -t compiledb` does not).
  CompilationDatabase: .pio/build/esp32dev
  Add:
    # The host clangd does not have a Xtensa backend, so the inferred target
    # triple `xtensa-esp32-elf` would fail. Pin the target to a 32-bit host
    # triple (ILP32, matching the ESP32's data model) for IntelliSense only.
    - --target=i386-pc-linux-gnu
    # Isolate from the host glibc/libstdc++ and provide the embedded toolchain's
    # libc/libstdc++ headers instead. The ESP-IDF build injects these via
    # `-specs=picolibc.specs`, which clangd (using the host clang) does not
    # process, so they are listed here explicitly.
    - -nostdlibinc
    - -nostdinc++
    - -isystem
    - /home/yourmum/.platformio/packages/toolchain-xtensa-esp-elf/picolibc/include
    - -isystem
    - /home/yourmum/.platformio/packages/toolchain-xtensa-esp-elf/xtensa-esp-elf/include/c++/15.2.0
    - -isystem
    - /home/yourmum/.platformio/packages/toolchain-xtensa-esp-elf/xtensa-esp-elf/include/c++/15.2.0/xtensa-esp-elf
  Remove:
    # GCC/xtensa-specific flags that the host clang reports as unknown.
    - -mlongcalls
    - -fno-shrink-wrap
    - -fstrict-volatile-bitfields
    - -fno-tree-switch-conversion
    # picolibc spec files are only meaningful for the cross toolchain.
    - -specs=
    # Don't turn every warning into an error in the editor.
    - -Werror
